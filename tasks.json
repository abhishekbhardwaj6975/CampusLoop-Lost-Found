{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Start Backend (Port 5000)",
      "type": "shell",
      "command": "node server/src/index.js",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*running on.*"
        }
      },
      "presentation": {
        "group": "servers",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "2. Start Frontend (Port 5173)",
      "type": "shell",
      "command": "npm.cmd --prefix client run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Network:.*"
        }
      },
      "presentation": {
        "group": "servers",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start CampusLoop (Backend + Frontend)",
      "dependsOn": [
        "1. Start Backend (Port 5000)",
        "2. Start Frontend (Port 5173)"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Re-seed Database",
      "type": "shell",
      "command": "npm.cmd --prefix server run seed",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    }
  ]
}
